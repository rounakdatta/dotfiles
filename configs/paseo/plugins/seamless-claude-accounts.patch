+// Only the Claude login moves between config dirs. The rest of a credential file (MCP servers'
+// OAuth logins, plugin secrets) belongs to the dir: carried along, it would be lost on a switch or
+// be live in two dirs at once. `raw` must hold a login.
+async function withLogin(path: string, raw: string): Promise<string> {
+  const { claudeAiOauth } = JSON.parse(raw) as { claudeAiOauth: unknown };
+  return JSON.stringify({ ...(await readJson(path)), claudeAiOauth });
+}
