+// A switch moves the Claude login and the device token its organization trusts. The rest of a
+// credential file belongs to the dir. MCP servers' OAuth logins rotate their refresh tokens, so a
+// copy in a second dir would break one of them. Client registrations and plugin secrets never
+// change, so a dir without them starts with the live dir's.
+const LOGIN_KEYS = ["claudeAiOauth", "trustedDeviceToken"];
+const FIXED_KEYS = ["mcpOAuthClientConfig", "pluginSecrets"];
+
+function pick(record: Record<string, unknown> | null, keys: string[]): Record<string, unknown> {
+  const picked: Record<string, unknown> = {};
+  for (const key of keys) if (record?.[key] !== undefined) picked[key] = record[key];
+  return picked;
+}
+
+/** The credential file `path` should hold to carry the login in `raw`, which must hold one. */
+async function withLogin(path: string, raw: string, live: string): Promise<string> {
+  const own = Object.entries((await readJson(path)) ?? {}).filter(([key]) => !LOGIN_KEYS.includes(key));
+  const seed = path === live ? {} : pick(await readJson(live), FIXED_KEYS);
+  const login = pick(JSON.parse(raw) as Record<string, unknown>, LOGIN_KEYS);
+  return JSON.stringify({ ...seed, ...Object.fromEntries(own), ...login });
+}
