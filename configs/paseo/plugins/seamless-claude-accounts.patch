+// Runs `run`, calling `after` right after the first file renamed into `path`: another writer, or a
+// crash, landing between the plugin's write and anything it does next.
+async function afterNextWriteTo<T>(path: string, after: () => Promise<void>, run: () => Promise<T>): Promise<T> {
+  const rename = fsp.rename;
+  let fired = false;
+  fsp.rename = (async (from: string, to: string) => {
+    await rename(from, to);
+    if (!fired && to === path) {
+      fired = true;
+      await after();
+    }
+  }) as typeof fsp.rename;
+  syncBuiltinESMExports();
+  try {
+    return await run();
+  } finally {
+    fsp.rename = rename;
+    syncBuiltinESMExports();
+  }
+}
